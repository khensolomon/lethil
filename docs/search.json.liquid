---
permalink: /search.json
---
{%- comment -%}
  Search index across ALL docs sections (docs, python, linux, …). Each section
  is a collection; site.data.sections lists them, and site[key] is that
  collection's docs. The `category` falls back to the section label so results
  group sensibly even if a page omits its own category.
{%- endcomment -%}
[
  {%- assign first = true -%}
  {%- for meta in site.data.sections -%}
    {%- include nav-docs.html key=meta.key -%}
    {%- assign sect_docs = nav_docs -%}
    {%- for doc in sect_docs -%}
      {%- include doc-title.html doc=doc -%}
        {%- unless first %},{% endunless -%}{%- assign first = false -%}
  {
    "title": {{ doc_title | jsonify }},
    "url": {{ doc.url | relative_url | jsonify }},
    "category": {{ doc.category | default: meta.label | jsonify }},
    "section": {{ meta.label | jsonify }},
    "content": {{ doc.content | strip_html | strip_newlines | jsonify }}
  }
    {%- endfor -%}
  {%- endfor -%}
]
