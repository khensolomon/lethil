---
permalink: /placeholders.json
sitemap: false
---
{%- comment -%}
  Every placeholder token used anywhere in the docs, discovered at build time so
  the settings form arrives pre-filled with the names that actually appear
  rather than an empty box.

  Liquid has no regex, so tokens are found by splitting on the HTML-escaped
  angle brackets kramdown emits inside code blocks. Occurrences are emitted
  RAW, duplicates and all — counting and de-duplicating is one line in JS and
  several awkward ones here, and the count is what lets the form put the most
  used names first.

  Secret-shaped names are FLAGGED, not excluded. They are handled differently
  at runtime — never substituted into the page, only injected at copy time —
  but hiding them from the form entirely just meant the tedious half of the job
  stayed tedious.

  One object per OCCURRENCE, carrying the page it appears on, so the form can
  show where each key is used and count uses without a second pass.
{%- endcomment -%}
{%- assign deny = "TOKEN,SECRET,KEY,PASSWORD,PASSWD,CREDENTIAL,PRIVATE,AUTH" | split: "," -%}
{%- assign out = "" -%}

{%- for meta in site.data.sections -%}
  {%- include nav-docs.html key=meta.key -%}
  {%- for d in nav_docs -%}
    {%- assign chunks = d.content | split: "&lt;" -%}
    {%- for chunk in chunks -%}
      {%- unless forloop.first -%}
        {%- if chunk contains "&gt;" -%}
          {%- assign tok = chunk | split: "&gt;" | first | strip -%}
          {%- assign up = tok | upcase -%}

          {%- comment -%} identifier-shaped only: no spaces, markup or punctuation runs {%- endcomment -%}
          {%- assign ok = true -%}
          {%- if tok == "" or tok.size > 40 -%}{%- assign ok = false -%}{%- endif -%}
          {%- if tok contains " " or tok contains "/" or tok contains "=" -%}{%- assign ok = false -%}{%- endif -%}
          {%- if tok contains "&" or tok contains ";" or tok contains '"' -%}{%- assign ok = false -%}{%- endif -%}

          {%- assign secret = false -%}
          {%- if ok -%}
            {%- for bad in deny -%}
              {%- if up contains bad -%}{%- assign secret = true -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if ok -%}
            {%- include doc-title.html doc=d -%}
            {%- assign tokj = tok | jsonify -%}
            {%- assign urlj = d.url | jsonify -%}
            {%- assign titlej = doc_title | jsonify -%}
            {%- if out != "" -%}{%- assign out = out | append: "," -%}{%- endif -%}
            {%- assign out = out
                  | append: '{"name":' | append: tokj
                  | append: ',"url":'  | append: urlj
                  | append: ',"title":' | append: titlej
                  | append: ',"secret":' | append: secret
                  | append: '}' -%}
          {%- endif -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endfor -%}
[{{ out }}]
