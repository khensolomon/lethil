---
permalink: /directory.json
sitemap: false
---
{%- comment -%}
  Data feed for the interactive Directory page (/directory/). One entry per navigable
  doc across every section, carrying its taxonomy (category + tags) plus the
  fields the card needs. Modelled on search.json — same collection walk, same
  "first" comma trick — so it builds identically on GitHub Pages with no plugin.
  category falls back to the section label when a page omits its own.
{%- endcomment -%}
[
  {%- assign first = true -%}
  {%- assign empty_tags = "" | split: "" -%}
  {%- for meta in site.data.sections -%}
    {%- include nav-docs.html key=meta.key -%}
    {%- assign sect_docs = nav_docs -%}
    {%- for doc in sect_docs -%}
      {%- include doc-title.html doc=doc -%}
        {%- unless first %},{% endunless -%}{%- assign first = false -%}
  {
    "title": {{ doc_title | jsonify }},
    "url": {{ doc.url | relative_url | jsonify }},
    "description": {{ doc.description | default: "" | jsonify }},
    "section": {{ meta.label | jsonify }},
    "sectionKey": {{ meta.key | jsonify }},
    "category": {{ doc.category | default: meta.label | jsonify }},
    "tags": {{ doc.tags | default: empty_tags | jsonify }},
    "status": {{ doc.status | default: "" | jsonify }}
  }
    {%- endfor -%}
  {%- endfor -%}
]
