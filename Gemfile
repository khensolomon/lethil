source "https://rubygems.org"

# Mirrors the exact gem versions GitHub Pages builds with, so local output
# matches production. Run: bundle install && bundle exec jekyll serve
gem "github-pages", group: :jekyll_plugins

# Windows / JRuby timezone + faster file watching
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
gem "wdm", "~> 0.1.1", platforms: [:mingw, :mswin, :x64_mingw]
